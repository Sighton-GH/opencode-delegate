#!/usr/bin/env bash
# oc-models — list opencode models as provider/model, free ones first.
#
#   oc-models             all models, free-tagged first
#   oc-models --free      free-tagged only
#   oc-models --verbose   tab-separated: id, context window, toolcall, reasoning, release date
#
# "Free" means the live catalog reports zero input AND output cost. Nothing
# here is hardcoded: Zen's free tier rotates, so we always ask opencode.
#
# Exit codes: 0 listed · 1 missing dependency · 2 bad argument ·
# 3 opencode's catalog could not be read in full (nothing is listed then).
set -euo pipefail

usage() { awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

free_only=0; verbose=0
for arg in "$@"; do
  case "$arg" in
    --free) free_only=1 ;;
    --verbose|-v) verbose=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "oc-models: unknown argument: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

for dep in opencode jq; do
  command -v "$dep" >/dev/null 2>&1 || { echo "oc-models: missing dependency: $dep" >&2; exit 1; }
done

# `opencode models --verbose` prints, per model, a bare "provider/model" line
# followed by a pretty-printed JSON object. It goes to a file first, never
# down a pipe: opencode exits without draining stdout, so a pipe whose reader
# is slower than opencode keeps only the first ~50 KB of a ~600 KB catalog.
# That was the "jq: parse error: Unfinished string at EOF" on almost every
# run, and the list behind it was partial (field report v0.4.0 #8, #31, #42).
# A file is written synchronously, so it is always whole. stdin is closed
# explicitly: opencode reads stdin to EOF whenever it is not a TTY, and inside
# an agent's shell it is usually a socket that never closes.
catalog=$(mktemp "${TMPDIR:-/tmp}/oc-models.XXXXXX")
parse_err=$(mktemp "${TMPDIR:-/tmp}/oc-models.XXXXXX")
trap 'rm -f "$catalog" "$parse_err"' EXIT

# opencode 2.0 dropped `models --verbose` (it prints help and exits 1); the
# same data — costs, context limits, capabilities — is served by its API.
# `api --standalone` answers through a throwaway private server, so no
# background service or password is needed.
oc_version=$(opencode --version </dev/null 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
oc_major=${oc_version%%.*}
[[ -n "$oc_major" && "$oc_major" != *[!0-9]* ]] \
  || { echo "oc-models: could not parse opencode's version (got: $(opencode --version </dev/null 2>&1 | head -1))" >&2; exit 1; }

if [[ "$oc_major" -ge 2 ]]; then
  opencode api --standalone model.list </dev/null >"$catalog" 2>/dev/null || true
  objects=$(jq -c '.data[]' "$catalog" 2>"$parse_err") || {
    echo "oc-models: opencode's model catalog did not parse ($(head -1 "$parse_err")); run \`opencode models\` to see the plain list" >&2
    exit 3
  }
  [[ -n "$objects" ]] || { echo "oc-models: opencode returned an empty model catalog; is it installed and authenticated?" >&2; exit 3; }
  # v2 shape: cost is an array of tiers, reasoning lives in capabilities or
  # compatibility.reasoningField, the release date is epoch milliseconds.
  jq -r --argjson free_only "$free_only" --argjson verbose "$verbose" '
        {
          id:   (.providerID + "/" + (.modelID // .id)),
          free: ((([.cost[]? | (.input // 0) + (.output // 0)] | add) // 0) == 0),
          ctx:  (.limit.context // 0),
          tool: (if (.capabilities.tools // .capabilities.toolcall) then "yes" else "no" end),
          reason: (if (.capabilities.reasoning // ((.compatibility.reasoningField // null) != null)) then "yes" else "no" end),
          date: (if (.time.released // 0) > 0 then (.time.released / 1000 | strftime("%Y-%m-%d")) else "" end)
        }
        | select($free_only == 0 or .free)
        | (if .free then "0" else "1" end) + "\t" + .id
          + (if $verbose == 1 then "\t" + (.ctx|tostring) + "\ttoolcall=" + .tool + "\treasoning=" + .reason + "\t" + .date else "" end)' <<<"$objects" \
    | sort -t$'\t' -k1,1 -k2,2 \
    | cut -f2-
  exit 0
fi

opencode models --verbose </dev/null >"$catalog" 2>/dev/null || true

# Parse the whole catalog before printing anything. A catalog that does not
# parse is reported as exactly that, with its own exit code: oc-task's 5
# means "rate limited", and jq's own exit status leaked through as 5 before
# (field report v0.4.0 #34).
objects=$({ grep -Ev '^[A-Za-z0-9_.-]+/[^[:space:]]+$' "$catalog" || true; } | jq -c . 2>"$parse_err") || {
  echo "oc-models: opencode's model catalog did not parse ($(head -1 "$parse_err")); run \`opencode models\` to see the plain list" >&2
  exit 3
}
[[ -n "$objects" ]] || { echo "oc-models: opencode returned an empty model catalog; is it installed and authenticated?" >&2; exit 3; }

jq -r --argjson free_only "$free_only" --argjson verbose "$verbose" '
      {
        id:   (.providerID + "/" + .id),
        free: ((.cost.input // 0) == 0 and (.cost.output // 0) == 0),
        ctx:  (.limit.context // 0),
        tool: (if .capabilities.toolcall then "yes" else "no" end),
        reason: (if .capabilities.reasoning then "yes" else "no" end),
        date: (.release_date // "")
      }
      | select($free_only == 0 or .free)
      | (if .free then "0" else "1" end) + "\t" + .id
        + (if $verbose == 1 then "\t" + (.ctx|tostring) + "\ttoolcall=" + .tool + "\treasoning=" + .reason + "\t" + .date else "" end)' <<<"$objects" \
  | sort -t$'\t' -k1,1 -k2,2 \
  | cut -f2-
