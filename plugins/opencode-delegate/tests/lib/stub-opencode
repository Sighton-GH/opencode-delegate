#!/usr/bin/env bash
# Fake `opencode` for the oc-task test suite. Real opencode is never invoked:
# this covers the three subcommands oc-task calls, with behaviour chosen by
# environment variables so one stub serves every scenario.
#
#   OC_STUB_STATE            dir this stub records observations into (required)
#   OC_STUB_VERSION          what `--version` prints (default 1.18.35). Set a
#                            2.x version and the stub switches to v2 behaviour:
#                            no --verbose catalog, `api --standalone model.list`
#                            instead, and run-args gain --server, lose --dir
#   OC_STUB_SESSION_STATUS   HTTP status for POST /session (default 200)
#   OC_STUB_SERVE_ERROR      an error message the stub server logs, as opencode
#                            does, OC_STUB_SERVE_ERROR_DELAY seconds (default 1)
#                            after the session is created
#   OC_STUB_MODELS_PAD       extra catalog lines printed after the real ids
#   OC_STUB_MODELS_VERBOSE   `models --verbose` output: ok (default) | truncated
#   OC_STUB_RUN_MODE         what `opencode run` does (default: ok)
#       ok        write a short event stream with a DONE RESULT block, create a
#                 file in the worktree and commit it
#       nochange  write the same event stream but touch nothing
#       stall     write one event, then nothing, and sleep until killed
#       silent    write nothing at all and sleep until killed
#       slowok    write one event, wait OC_STUB_RUN_PAUSE seconds, then do `ok`
#       poison    emit the provider's encrypted_content error
#       fail      emit a generic error event and exit 1
#       ratelimit emit a 429 error event and exit 1
#       usage     emit a usage-limit error with a reset time and exit 1
#       dbbusy    emit opencode's "Failed to execute statement" and exit 1
#       errhang   emit an error event, then sleep until killed
#       noisy     print a plain-text stderr line before the events, then `ok`
#       dup       commit a file and emit a RESULT block with every line doubled
#       needsctx  end with a NEEDS_CONTEXT status line but no RESULT heading
#       stage     stage a file, leave a stale index.lock, emit DONE, exit 0
#       ctrl      write and commit a file containing a raw control byte
#   OC_STUB_RUN_SLEEP        seconds `run` sleeps before acting (default 0)
set -uo pipefail

state="${OC_STUB_STATE:?stub needs OC_STUB_STATE}"
mkdir -p "$state"

# `opencode run` reads its prompt from stdin. Drain it so the caller's
# redirection behaves the way it does against the real binary.
drain_stdin() { cat >"$state/last-prompt" 2>/dev/null || true; }

emit() { printf '%s\n' "$1"; }

RESULT_TEXT='## RESULT\nStatus: DONE\nFiles changed: stub-output.txt\nCommits: stub\nCommands run and their outcome: none\nCould not complete: nothing\nAssumptions made: none\nConcerns or questions: none\n'

do_ok() { # $1 = worktree
  printf 'stub wrote this\n' >>"$1/stub-output.txt"
  git -C "$1" add -A >/dev/null 2>&1 || true
  git -C "$1" -c user.name=stub -c user.email=stub@localhost \
      commit -q -m "stub: implement the brief" >/dev/null 2>&1 || true
  emit '{"type":"text","part":{"id":"prt_result","text":"'"$RESULT_TEXT"'"}}'
}

stub_major=${OC_STUB_VERSION:-1.18.35}
stub_major=${stub_major%%.*}

case "${1:-}" in
  --version|-v|version)
    emit "opencode v${OC_STUB_VERSION:-1.18.35}"
    exit 0
    ;;

  api)
    # The v2 oc-models path: `opencode api --standalone model.list`.
    printf '%s\n' "$*" >"$state/api-args"
    if [[ "$stub_major" -lt 2 ]]; then
      emit "stub-opencode: api needs OC_STUB_VERSION 2.x" >&2
      exit 127
    fi
    emit '{"data":['
    emit '{"id":"muse-spark-1.3-contributor-free","modelID":"muse-spark-1.3-contributor-free","providerID":"opencode","cost":[{"input":0,"output":0}],"limit":{"context":1048576},"capabilities":{"tools":true,"reasoning":true},"time":{"released":1788393600000}},'
    emit '{"id":"stub-alternate-free","modelID":"stub-alternate-free","providerID":"opencode","cost":[{"input":0,"output":0}],"limit":{"context":200000},"capabilities":{"tools":true},"time":{"released":1788393600000}},'
    if [[ "${OC_STUB_MODELS_VERBOSE:-ok}" == truncated ]]; then
      printf '%s' '{"id":"paid-model","providerID":"opencode","cost":[{"input":1,"outp'
      exit 0
    fi
    emit '{"id":"paid-model","modelID":"paid-model","providerID":"opencode","cost":[{"input":1,"output":2}],"limit":{"context":200000},"capabilities":{"tools":true},"time":{"released":1767225600000}}'
    emit ']}'
    exit 0
    ;;

  models)
    # oc-task greps this for an exact match on the configured model id.
    if [[ "${2:-}" == "--verbose" ]]; then
      if [[ "$stub_major" -ge 2 ]]; then
        # Real v2 prints help and exits 1: no --verbose flag.
        emit "stub-opencode: models --verbose does not exist in v2" >&2
        exit 1
      fi
      emit 'opencode/muse-spark-1.3-contributor-free'
      emit '{"id":"muse-spark-1.3-contributor-free","providerID":"opencode","cost":{"input":0,"output":0},"limit":{"context":1048576},"capabilities":{"toolcall":true,"reasoning":true},"release_date":"2026-09-02"}'
      emit 'opencode/paid-model'
      if [[ "${OC_STUB_MODELS_VERBOSE:-ok}" == truncated ]]; then
        printf '%s' '{"id":"paid-model","providerID":"opencode","cost":{"input":1,"outp'
        exit 0
      fi
      emit '{"id":"paid-model","providerID":"opencode","cost":{"input":1,"output":2},"limit":{"context":200000},"capabilities":{"toolcall":true,"reasoning":false},"release_date":"2026-01-01"}'
      exit 0
    fi
    emit 'opencode/muse-spark-1.3-contributor-free'
    emit 'opencode/stub-alternate-free'
    # oc-task's built-in default must pass its own catalog check.
    emit 'opencode/big-pickle'
    for (( i = 0; i < ${OC_STUB_MODELS_PAD:-0}; i++ )); do emit "pad/model-$i"; done
    exit 0
    ;;

  serve)
    port=""
    printf '%s\n' "$*" >"$state/serve-args"
    while [[ $# -gt 0 ]]; do
      case "$1" in --port) port="${2:-}"; shift 2 ;; *) shift ;; esac
    done
    exec python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/stub-server.py" "$port"
    ;;

  run)
    drain_stdin
    printf '%s\n' "$*" >"$state/run-args"
    dir="$PWD"
    while [[ $# -gt 0 ]]; do
      case "$1" in --dir) dir="${2:-}"; shift 2 ;; *) shift ;; esac
    done
    sleep "${OC_STUB_RUN_SLEEP:-0}"
    case "${OC_STUB_RUN_MODE:-ok}" in
      stall)
        # One event, then the process stays alive, the log never grows, and
        # no error is ever emitted.
        emit '{"type":"step_start","part":{"id":"prt_step"}}'
        sleep 3600
        exit 0
        ;;
      silent)
        # Not a single event: what a run refused by its provider looks like.
        sleep 3600
        exit 0
        ;;
      slowok)
        emit '{"type":"step_start","part":{"id":"prt_step"}}'
        sleep "${OC_STUB_RUN_PAUSE:-3}"
        emit '{"type":"step_start","part":{"id":"prt_step2"}}'
        do_ok "$dir"
        exit 0
        ;;
      poison)
        emit '{"type":"error","error":{"name":"APIError","data":{"message":"Error from provider (Console): Upstream request failed: [invalid_request_error] reasoning `encrypted_content` was not issued to this caller"}}}'
        exit 1
        ;;
      ratelimit)
        emit '{"type":"error","error":{"name":"APIError","data":{"message":"429 Too Many Requests: rate limit exceeded"}}}'
        exit 1
        ;;
      usage)
        emit '{"type":"error","error":{"name":"APIError","data":{"message":"AI_APICallError: Usage limit reached. Resets in 3h 51m."}}}'
        exit 1
        ;;
      dbbusy)
        emit '{"type":"error","error":{"name":"UnknownError","data":{"message":"Failed to execute statement"}}}'
        exit 1
        ;;
      errhang)
        emit '{"type":"error","error":{"code":"ECONNRESET","path":"http://127.0.0.1:1/session/x/message"}}'
        sleep 3600
        exit 0
        ;;
      fail)
        emit '{"type":"error","error":{"name":"APIError","data":{"message":"stub failure"}}}'
        exit 1
        ;;
      nochange)
        emit '{"type":"text","part":{"text":"## RESULT\nStatus: DONE\nFiles changed: none\n"}}'
        exit 0
        ;;
      noisy)
        echo "Warning: something opencode printed to stderr" >&2
        do_ok "$dir"
        exit 0
        ;;
      dup)
        # Every line of the block twice, as one model emitted it (field
        # report v0.4.0 #9).
        printf 'stub wrote this\n' >>"$dir/stub-output.txt"
        git -C "$dir" add -A >/dev/null 2>&1 || true
        git -C "$dir" -c user.name=stub -c user.email=stub@localhost commit -q -m "stub" >/dev/null 2>&1 || true
        emit '{"type":"text","part":{"id":"prt_result","text":"## RESULT\n## RESULT\nStatus: DONE\nStatus: DONE\nFiles changed: stub-output.txt\nFiles changed: stub-output.txt\n"}}'
        exit 0
        ;;
      needsctx)
        emit '{"type":"text","part":{"id":"prt_q","text":"I read the brief.\nStatus: NEEDS_CONTEXT — which config file should the flag go in?\n"}}'
        exit 0
        ;;
      stage)
        printf 'staged but never committed\n' >"$dir/staged.txt"
        git -C "$dir" add staged.txt >/dev/null 2>&1 || true
        : >"$(git -C "$dir" rev-parse --git-dir)/index.lock"
        emit '{"type":"text","part":{"id":"prt_result","text":"'"$RESULT_TEXT"'"}}'
        exit 0
        ;;
      ctrl)
        printf 'const re = /[\001]/;\n' >"$dir/stub-output.txt"
        git -C "$dir" add -A >/dev/null 2>&1 || true
        git -C "$dir" -c user.name=stub -c user.email=stub@localhost \
            commit -q -m "stub: a control byte" >/dev/null 2>&1 || true
        emit '{"type":"text","part":{"id":"prt_result","text":"'"$RESULT_TEXT"'"}}'
        exit 0
        ;;
      ok|*)
        do_ok "$dir"
        exit 0
        ;;
    esac
    ;;

  *)
    emit "stub-opencode: unsupported subcommand: ${1:-<none>}" >&2
    exit 127
    ;;
esac
